{
  "manifest_version": 3,
  "name": "Context Capsule",
  "version": "1.0.0",
  "description": "Capture and reuse AI conversation context.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Context Capsule"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/adapters.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
